# .env.example

# OpenEnv Environment Configuration
ENV_NAME=python-debug-env
ENV_PORT=8000

# LLM Configuration (for inference script only, not grading)
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# Authentication
HF_TOKEN=your_huggingface_token_here

# Optional: Docker image name
IMAGE_NAME=python-debug-env:latest

# Optional: Task selection for testing
MY_ENV_V4_TASK=fix_logic_bug
MY_ENV_V4_BENCHMARK=python-debug-env

# Optional: Enable debug logging
DEBUG=false
