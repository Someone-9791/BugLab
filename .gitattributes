* text=auto

# Python files
*.py eol=lf
*.pyc eol=lf
*.pyw eol=lf
*.pyx eol=lf
*.pyi eol=lf

# Shell scripts
*.sh eol=lf
*.bash eol=lf

# Text files
*.md eol=lf
*.txt eol=lf
*.yaml eol=lf
*.yml eol=lf
*.json eol=lf
*.toml eol=lf
*.cfg eol=lf
*.ini eol=lf

# Documentation
*.rst eol=lf

# Windows specific
*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=crlf

# Binary files (not converted)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.tar binary
*.gz binary
